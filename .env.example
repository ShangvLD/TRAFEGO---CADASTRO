# Copie este arquivo para ".env" e ajuste os valores.
# O .env NÃO deve ser versionado (já está no .gitignore).

# Porta em que o servidor vai rodar (só no desenvolvimento local)
PORT=3000

# ---------------------------------------------------------------------------
# Banco de dados — Supabase (PostgreSQL)
# ---------------------------------------------------------------------------
# OBRIGATÓRIO, tanto local quanto em produção (não existe mais banco em arquivo).
#
# Onde pegar: painel do Supabase > botão "Connect" (no topo) > aba
# "Connection string" > "Transaction pooler". Troque [YOUR-PASSWORD] pela senha
# do banco (Settings > Database > Database password — dá para redefinir lá).
#
# Use a URL do POOLER (porta 6543), que é a indicada para serverless/Vercel:
#   postgresql://postgres.<REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres
#
# No Vercel, esta variável vai em Settings > Environment Variables (NÃO aqui).
DATABASE_URL=

# Segredo usado para assinar os cookies de sessão.
# Troque por um valor longo e aleatório em produção.
SESSION_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio

# Segredo compartilhado com o Power Automate para o webhook do Microsoft Forms.
# O Power Automate deve enviá-lo no cabeçalho "x-webhook-secret" a cada resposta.
# Enquanto estiver vazio/ausente, o webhook fica DESLIGADO (retorna 503).
# Gere um valor longo e aleatório (ex.: no PowerShell: [guid]::NewGuid().ToString()).
FORMS_WEBHOOK_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ---------------------------------------------------------------------------
# Turso (banco ANTIGO) — só para a migração
# ---------------------------------------------------------------------------
# Necessário apenas para rodar "npm run exportar-turso" e gerar o dump dos
# dados antigos. Depois que a migração estiver confirmada, pode remover.
# TURSO_DATABASE_URL=libsql://trafego-cadastro-SEU-USUARIO.turso.io
# TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Armazenamento de arquivos (upload nativo)
# ---------------------------------------------------------------------------
# O Vercel tem disco efêmero: arquivo gravado no servidor desaparece. Os anexos
# vão para o Supabase Storage, do mesmo projeto que já hospeda o banco.
#
# Onde pegar: painel do Supabase > Settings > API Keys > "service_role".
# É uma chave ADMINISTRATIVA: nunca exponha no navegador, só no servidor.
SUPABASE_SERVICE_KEY=

# Opcionais — os padrões servem na maioria dos casos.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co   (deduzida da DATABASE_URL)
# SUPABASE_BUCKET=cadastros
# UPLOAD_MAX_MB=15
# STORAGE_PROVEDOR=supabase                       (ou "memoria", para teste)

# ---------------------------------------------------------------------------
# Espelho no canal do Teams (npm run sincronizar-canal)
# ---------------------------------------------------------------------------
# Pasta do canal sincronizada pelo OneDrive NESTA máquina. O script copia para
# lá os documentos do portal, e o OneDrive sobe para o canal do Teams.
#
# Só é usado pelo script, nunca pelo app: em produção o portal roda no Vercel e
# não alcança pasta nenhuma da sua máquina.
# PASTA_CANAL=C:\Users\voce\OneDrive - Empresa\EQUIPE\PASTA DO CANAL
# SINCRONIZAR_INTERVALO_S=60
