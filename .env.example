# Copie este arquivo para ".env" e ajuste os valores.
# O .env NÃO deve ser versionado (já está no .gitignore).

# Porta em que o servidor vai rodar (só no desenvolvimento local)
PORT=3000

# ---------------------------------------------------------------------------
# Banco de dados — Supabase (PostgreSQL)
# ---------------------------------------------------------------------------
# OBRIGATÓRIO, tanto local quanto em produção (não existe mais banco em arquivo).
#
# Onde pegar: painel do Supabase > botão "Connect" (no topo) > aba
# "Connection string" > "Transaction pooler". Troque [YOUR-PASSWORD] pela senha
# do banco (Settings > Database > Database password — dá para redefinir lá).
#
# Use a URL do POOLER (porta 6543), que é a indicada para serverless/Vercel:
#   postgresql://postgres.<REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres
#
# No Vercel, esta variável vai em Settings > Environment Variables (NÃO aqui).
DATABASE_URL=

# Segredo usado para assinar os cookies de sessão.
#
# OBRIGATÓRIO em produção (NODE_ENV=production) e com no mínimo 16 caracteres:
# sem ele o app NÃO SOBE. Antes havia um valor de reserva escrito no código, e
# um cookie assinado com segredo público é um cookie que qualquer um forja.
#
# Gere assim:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio

# Segredo compartilhado com o Power Automate para o webhook do Microsoft Forms.
# O Power Automate deve enviá-lo no cabeçalho "x-webhook-secret" a cada resposta.
# Enquanto estiver vazio/ausente, o webhook fica DESLIGADO (retorna 503).
# Gere um valor longo e aleatório (ex.: no PowerShell: [guid]::NewGuid().ToString()).
FORMS_WEBHOOK_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ---------------------------------------------------------------------------
# Turso (banco ANTIGO) — só para a migração
# ---------------------------------------------------------------------------
# Necessário apenas para rodar "npm run exportar-turso" e gerar o dump dos
# dados antigos. Depois que a migração estiver confirmada, pode remover.
# TURSO_DATABASE_URL=libsql://trafego-cadastro-SEU-USUARIO.turso.io
# TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Armazenamento de arquivos (upload nativo)
# ---------------------------------------------------------------------------
# O Vercel tem disco efêmero: arquivo gravado no servidor desaparece. Os anexos
# vão para o Supabase Storage, do mesmo projeto que já hospeda o banco.
#
# Onde pegar: painel do Supabase > Settings > API Keys > "service_role".
# É uma chave ADMINISTRATIVA: nunca exponha no navegador, só no servidor.
SUPABASE_SERVICE_KEY=

# Opcionais — os padrões servem na maioria dos casos.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co   (deduzida da DATABASE_URL)
# SUPABASE_BUCKET=cadastros
# UPLOAD_MAX_MB=15

# Qual provedor usar. Se não definir, o app escolhe sozinho: "pasta" quando
# PASTA_CANAL aponta para um diretório que existe, senão "supabase".
#   supabase   Supabase Storage. Funciona em produção (Vercel). O navegador
#              envia direto ao storage, por URL assinada.
#   pasta      grava na PASTA_CANAL abaixo. Só funciona com o app rodando na
#              máquina que tem a pasta; o arquivo passa pelo servidor.
#   memoria    só para teste automatizado; some ao reiniciar.
# Pedir "pasta" onde a pasta não existe (Vercel) cai para o supabase sozinho.
# STORAGE_PROVEDOR=pasta

# ---------------------------------------------------------------------------
# Pasta do canal do Teams
# ---------------------------------------------------------------------------
# Pasta do canal sincronizada pelo OneDrive NESTA máquina. Serve para duas
# coisas:
#   1. destino dos uploads, quando STORAGE_PROVEDOR=pasta (ou automático);
#   2. destino do espelho (npm run sincronizar-canal), que copia para lá o que
#      já está no Supabase.
#
# Em produção o portal roda no Vercel e não alcança pasta nenhuma da sua
# máquina — lá o provedor volta a ser o Supabase.
#
# Use barras normais mesmo no Windows: no .env a barra invertida é literal, mas
# basta uma ferramenta interpretar escape para "\U" corromper o caminho.
# PASTA_CANAL=C:/Users/voce/OneDrive - Empresa/EQUIPE/PASTA DO CANAL
# SINCRONIZAR_INTERVALO_S=60

# ---------------------------------------------------------------------------
# TLS da conexão com o banco (opcional)
# ---------------------------------------------------------------------------
# O projeto já traz a CA oficial da Supabase embutida (src/supabase-ca.js) e
# valida o certificado do servidor — não precisa configurar nada.
#
# As três variáveis abaixo só existem para o dia em que a Supabase trocar a CA:
#
#   DATABASE_CA        o PEM inteiro, colado numa variável de ambiente
#   DATABASE_CA_FILE   caminho de um arquivo .crt no disco
#   DATABASE_SSL_STRICT=0  desliga a validação (volta ao comportamento antigo,
#                          criptografado mas sem conferir com quem se fala).
#                          Use só como emergência, e por pouco tempo.
# DATABASE_CA=
# DATABASE_CA_FILE=
# DATABASE_SSL_STRICT=
